# forti-api (header-only SDK). System installs (libforti-api-dev, Homebrew forti-api) are preferred;
# this wrap is the fallback for source builds. For SDK co-development, replace subprojects/forti-api
# with a checkout (or a symlink to ../forti-api) and Meson uses it instead of downloading.
[wrap-git]
url = https://github.com/valkyrianlabs/forti-api.git
revision = v1.2.0
depth = 1

[provide]
forti-api = forti_api_dep
